.github
.idea
.vscode
.devcontainer
.junie
intel
**/.env
**/.env.*
**/*.db
**/*.db-journal
**/*.db-wal
**/*.db-shm
dist
**/coverage.*
**/*.out
**/*.test
salus
salus-ci*
